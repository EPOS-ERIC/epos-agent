# Create /etc/epos-mcp.env with mode 0600. Token values are never logged.
# Map bearer token to a stable name and least-privilege scopes.
EPOS_MCP_TOKENS_JSON={"replace-reader":{"name":"reader","scopes":["search","artifacts"]},"replace-operator":{"name":"operator","scopes":["search","execute","artifacts","metrics"]}}
# Legacy alternative: EPOS_MCP_AUTH_TOKEN=single-admin-token
EPOS_MCP_ALLOWED_ORIGINS=https://mcp.example.org
EPOS_API_BASE=https://www.ics-c.epos-eu.org/api/v1
EPOS_PUBLIC_BASE_URL=https://mcp.example.org
EPOS_MAX_TIME_RANGE_DAYS=366
EPOS_MAX_BBOX_AREA_DEGREES=1000
EPOS_CONFIRM_TIME_RANGE_DAYS=90
EPOS_CONFIRM_BBOX_AREA_DEGREES=100
EPOS_STATE_TTL_SECONDS=1800
EPOS_MAX_ARTIFACTS=1000
EPOS_RATE_LIMIT_PER_MINUTE=60
EPOS_AUDIT_LOG_PATH=/var/log/epos-mcp/audit.jsonl
EPOS_AUDIT_MAX_BYTES=10485760
EPOS_AUDIT_BACKUPS=5
