# This directive belongs in nginx's http context (for example /etc/nginx/conf.d).
limit_req_zone $binary_remote_addr zone=epos_mcp:10m rate=30r/m;

# Place behind a TLS-enabled server block for mcp.example.org.
# Configure the certificate with Certbot or the platform's certificate manager.
server {
    listen 443 ssl http2;
    server_name mcp.example.org;

    ssl_certificate /etc/letsencrypt/live/mcp.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcp.example.org/privkey.pem;
    client_max_body_size 1m;

    location = /mcp {
        proxy_pass http://127.0.0.1:8765/mcp;
        proxy_http_version 1.1;
        limit_req zone=epos_mcp burst=10 nodelay;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 130s;
    }

    location /artifacts/ {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        limit_req zone=epos_mcp burst=10 nodelay;
    }

    location /metrics {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
    }
}
