#!/usr/bin/env bash
set -euo pipefail
ROOT="${EPOS_AGENT_ROOT:-$HOME/epos-agent}"
PI_BIN="${PI_BIN:-$ROOT/.runtime/node_modules/.bin/pi}"

setup_gemini() {
  local profile temp_profile gemini_key
  profile="$ROOT/config/profile.env"

  [[ -t 0 && -t 1 ]] || {
    echo "epos-agent: --setup-gemini requires an interactive terminal" >&2
    exit 1
  }

  mkdir -p "$ROOT/config"
  printf 'Create a Gemini API key in Google AI Studio:\nhttps://aistudio.google.com/app/apikey\n\n'
  printf 'Paste the key (it will not be displayed): '
  IFS= read -r -s gemini_key
  printf '\n'
  [[ -n "$gemini_key" ]] || {
    echo "epos-agent: no Gemini API key was provided" >&2
    exit 1
  }

  temp_profile="$(mktemp "$ROOT/config/profile.env.XXXXXX")"/
  if [[ -f "$profile" ]]; then
    awk '!/^(GEMINI_API_KEY|EPOS_PROVIDER|EPOS_MODEL)=/' "$profile" > "$temp_profile"
  fi
  printf 'GEMINI_API_KEY=%q\nEPOS_PROVIDER=google\n' "$gemini_key" >> "$temp_profile"
  chmod 600 "$temp_profile"
  mv "$temp_profile" "$profile"
  unset gemini_key

  printf 'Gemini is configured for EPOS Agent. Start it normally, then use /model to choose a Gemini model.\n'
}

if [[ "${1:-}" == "--setup-gemini" ]]; then
  setup_gemini
  exit 0
fi

if [[ ! -x "$PI_BIN" ]]; then
  PI_BIN="$(command -v pi || true)"
fi
if [[ -z "${PI_BIN:-}" || ! -x "$PI_BIN" ]]; then
  echo "epos-agent: cannot find executable pi runtime" >&2
  exit 127
fi
mkdir -p "$ROOT"/{cache,sessions,logs,logs/provenance,config/pi-agent}
if [[ -f "$ROOT/config/profile.env" ]]; then
  # shellcheck disable=SC1091
  source "$ROOT/config/profile.env"
fi
provider="${EPOS_PROVIDER:-${PI_PROVIDER:-}}"
model="${EPOS_MODEL:-${PI_MODEL:-}}"
thinking="${EPOS_THINKING:-${PI_REASONING_LEVEL:-}}"

# Start from a clean terminal before handing control to Pi's TUI.
if [[ -t 1 ]]; then
  printf '\033[2J\033[H'
fi

if [[ -t 1 ]]; then
  EPOS_GREEN=$'\033[38;2;43;66;45m'
  EPOS_GOLD=$'\033[38;2;198;148;54m'
  EPOS_WHITE=$'\033[38;2;255;255;255m'
  EPOS_DIM=$'\033[38;2;111;138;115m'
  EPOS_RESET=$'\033[0m'
else
  EPOS_GREEN=""; EPOS_GOLD=""; EPOS_WHITE=""; EPOS_DIM=""; EPOS_RESET=""
fi

printf '%b' "
${EPOS_GREEN}╔══════════════════════════════════════════════════════════════════════════════════╗${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                                                                                  ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                   ${EPOS_GOLD}●●●•${EPOS_RESET}${EPOS_DIM}∙·‧${EPOS_RESET}${EPOS_WHITE}███████╗██████╗${EPOS_DIM}·${EPOS_RESET}${EPOS_WHITE} ██████╗${EPOS_DIM}·${EPOS_RESET}${EPOS_WHITE}███████╗${EPOS_RESET}                       ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}               ${EPOS_GOLD}●●●●●●●•${EPOS_RESET}${EPOS_DIM}∙·‧${EPOS_RESET}${EPOS_WHITE}██╔════╝██╔══██╗██╔═══██╗██╔════╝${EPOS_RESET}                       ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}              ${EPOS_GOLD}●●●●●●●●•${EPOS_RESET}${EPOS_DIM}∙·‧${EPOS_RESET}${EPOS_WHITE}█████╗${EPOS_DIM}·${EPOS_RESET}${EPOS_WHITE} ██████╔╝██║ ${EPOS_DIM}·${EPOS_RESET}${EPOS_WHITE} ██║███████╗${EPOS_RESET}                       ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}              ${EPOS_GOLD}●●●●●●●●•${EPOS_RESET}${EPOS_DIM}∙·‧${EPOS_RESET}${EPOS_WHITE}██╔══╝ ${EPOS_DIM}·${EPOS_RESET}${EPOS_WHITE}██╔═══╝ ██║ ${EPOS_DIM}·${EPOS_RESET}${EPOS_WHITE} ██║╚════██║${EPOS_RESET}                       ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                ${EPOS_GOLD}●●●●●●•${EPOS_RESET}${EPOS_DIM}∙·‧${EPOS_RESET}${EPOS_WHITE}███████╗██║  ${EPOS_DIM}‧${EPOS_RESET}${EPOS_WHITE}  ╚██████╔╝███████║${EPOS_RESET}                       ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                   ${EPOS_GOLD}●●●•${EPOS_RESET}${EPOS_DIM}∙·‧${EPOS_RESET}${EPOS_WHITE}╚══════╝╚═╝  ${EPOS_DIM}·${EPOS_RESET}${EPOS_WHITE}   ╚═════╝ ╚══════╝${EPOS_RESET}                       ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                                                                                  ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                         ${EPOS_GOLD}EUROPEAN PLATE OBSERVING SYSTEM${EPOS_RESET}                          ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                     ${EPOS_GOLD}────────────────────────────────────────${EPOS_RESET}                     ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                               ${EPOS_WHITE}EPOS Agent · ${EPOS_RESET}${EPOS_GOLD}V1.0.1${EPOS_RESET}                                ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                                                                                  ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}          ${EPOS_WHITE}Solid Earth data services, metadata, provenance and discovery${EPOS_RESET}           ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                                                                                  ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}             ${EPOS_WHITE}Search${EPOS_RESET} ${EPOS_GOLD}│${EPOS_RESET} ${EPOS_WHITE}Describe${EPOS_RESET} ${EPOS_GOLD}│${EPOS_RESET} ${EPOS_WHITE}Validate${EPOS_RESET} ${EPOS_GOLD}│${EPOS_RESET} ${EPOS_WHITE}Execute${EPOS_RESET} ${EPOS_GOLD}│${EPOS_RESET} ${EPOS_WHITE}Cite provenance${EPOS_RESET}             ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}║${EPOS_RESET}                                                                                  ${EPOS_GREEN}║${EPOS_RESET}
${EPOS_GREEN}╚══════════════════════════════════════════════════════════════════════════════════╝${EPOS_RESET}
"

declare -a args=(
  --no-extensions
  --no-skills
  --no-prompt-templates
  --no-context-files
  --session-dir "$ROOT/sessions"
  --system-prompt "$(cat "$ROOT/prompts/SYSTEM.md")"
  --skill "$ROOT/skills"
  --extension "$ROOT/tools/agent-runtime/index.ts"
  --theme "$ROOT/themes/epos-corporate.json"
  --use-theme "epos-corporate"
  --tools "read,grep,find,ls,write,edit,epos_load_tools,epos_manage_study,epos_search,epos_search_page,epos_select_candidate,epos_search_filter,epos_organizations,epos_details,epos_prepare_execute,epos_execute,epos_inspect,epos_visualize,epos_fetch,epos_prepare_visualization,epos_run_python,epos_finalize_notebook,epos_show_image,epos_fdsnws_event_call"
)
[[ -n "$provider" ]] && args+=(--provider "$provider")
[[ -n "$model" ]] && args+=(--model "$model")
[[ -n "$thinking" ]] && args+=(--thinking "$thinking")
export EPOS_AGENT_ROOT="$ROOT"
export PI_CODING_AGENT_DIR="$ROOT/config/pi-agent"
export PI_CODING_AGENT_SESSION_DIR="$ROOT/sessions"
export PI_SKIP_VERSION_CHECK=1
export XDG_CACHE_HOME="$ROOT/cache/xdg"
exec "$PI_BIN" "${args[@]}" "$@"
