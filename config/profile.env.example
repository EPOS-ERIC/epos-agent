# EPOS Agent — provider and model configuration
#
# Uncomment and set the variables for your chosen provider.
# The selected model must support tool calling.
#
# ── Google Gemini ────────────────────────────────────────────────
# EPOS_PROVIDER=google
# GEMINI_API_KEY=your-key-here
# EPOS_MODEL=gemini-2.5-pro
# EPOS_THINKING=medium
#
# ── Anthropic Claude ─────────────────────────────────────────────
# EPOS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here
# EPOS_MODEL=claude-sonnet-4-5
#
# ── OpenAI ───────────────────────────────────────────────────────
# EPOS_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# EPOS_MODEL=gpt-4o
